# Build artifacts
build/
sdkconfig.old
managed_components/
dependencies.lock

# Node / plugin dev
node_modules/

# Python
.venv/
__pycache__/

# Secrets / credentials — never commit
*.key
*.pem
.env

# Logs and captured audio (golden fixtures are force-added intentionally)
*.log
*.pcm
*.opus

# 刷写产物（本地保留，二进制不入库）
flash-artifacts/
host/src/*.obj
host/src/*.exe

# 演示用捕获产物（可由 tools/make_synth_capture.py 重新生成，不入库）
captures/

# 屏幕模拟输出（可由 tools/gen_screen_mock.py 重新生成，不入库）
screen_mock*.png

# 托盘图标预览（可由 tools/gen_tray_icon.py 重新生成，不入库）
tray_icon_preview.png
